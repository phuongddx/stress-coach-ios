# Xcode
#
# Based on https://github.com/github/gitignore/blob/main/Swift.gitignore
# and https://github.com/github/gitignore/blob/main/Global/Xcode.gitignore

## User settings
xcuserdata/
*.xcuserstate
*.xcuserdatad

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
# *.xcodeproj
#
# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
# .swiftpm

.build/

# CocoaPods
#
# We recommend against adding the Pods directory to your .gitignore. However
# you should judge for yourself, the pros and cons are mentioned at:
# https://guides.cocoapods.org/using/using-cocoapods.html#should-i-check-the-pods-directory-into-source-control
#
# Pods/

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build/

# Accio dependency management
Dependencies/
.accio/

# fastlane
#
# It is recommended to not store the screenshots in the git repo.
# Instead, use fastlane to re-generate the screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/#source-control

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
#
# After new code Injection tools there's a generated folder /iOSInjectionProject
# https://github.com/johnno1962/injectionforxcode

iOSInjectionProject/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Xcode Patch
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/project.xcworkspace/xcshareddata/
!*.xcworkspace/contents.xcworkspacedata/*.xcscmblueprint
*.xcworkspace/xcuserdata/

# Bundle artifacts
*.xcarchive

# CocoaPods artifacts
Pods/

# Carthage artifacts
Carthage/Build/

# AppCode specific files
.idea/

# VSCode specific files
.vscode/

# SwiftFormat
.swiftformat

# SwiftLint
.swiftlint.yml

# SPM
.swiftpm/
.build/

# Xcode file references
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Temporary files
*~
.tmp/
*.tmp
*.bak
*.swp

# Test artifacts
*.gcno
*.gcda
coverage.xml
test_output/

# DerivedData
DerivedData/

# Archives
*.xcarchive

# CloudKit - Schema files (optional, uncomment if you want to ignore schema files)
# *.xcdatamodeld/**/*.ccd
.mcp.json

# Runtime logs and session state
.omx/logs/
.claude/session-state/
.claude/worktrees/
tmp-home/
.gitnexus
vendor/bundle
build/
.worktrees/

# spm-cache (sandbox, lockfile, build artifacts - regenerated locally).
# Exception: the local proxy package under packages/proxy is source-tracked — the
# Xcode project references it via XCLocalSwiftPackageReference "spm-cache/packages/proxy",
# so clean checkouts (CI) need its manifests + shim sources. Everything else
# (clone cache, .build, .swiftpm state, graph.json) stays ignored/regenerated.
StressMonitor/spm-cache/*
StressMonitor/spm-cache.lock
StressMonitor/spm-cache.yml
!StressMonitor/spm-cache/packages/
StressMonitor/spm-cache/packages/*
!StressMonitor/spm-cache/packages/proxy/
StressMonitor/spm-cache/packages/proxy/*
!StressMonitor/spm-cache/packages/proxy/Package.swift
!StressMonitor/spm-cache/packages/proxy/Package.resolved
!StressMonitor/spm-cache/packages/proxy/src/
!StressMonitor/spm-cache/packages/proxy/.proxies/
StressMonitor/spm-cache/packages/proxy/.proxies/*
!StressMonitor/spm-cache/packages/proxy/.proxies/Firebase_proxy/
StressMonitor/spm-cache/packages/proxy/.proxies/Firebase_proxy/*
!StressMonitor/spm-cache/packages/proxy/.proxies/Firebase_proxy/Package.swift
!StressMonitor/spm-cache/packages/proxy/.proxies/Firebase_proxy/Sources/
!StressMonitor/spm-cache/packages/proxy/.proxies/GoogleSignIn-iOS_proxy/
StressMonitor/spm-cache/packages/proxy/.proxies/GoogleSignIn-iOS_proxy/*
!StressMonitor/spm-cache/packages/proxy/.proxies/GoogleSignIn-iOS_proxy/Package.swift
!StressMonitor/spm-cache/packages/proxy/.proxies/GoogleSignIn-iOS_proxy/Sources/
StressMonitor/build_output.log
StressMonitor/test_output.log
.claude/
StressMonitor/StressMonitor.xcodeproj/StressMonitor.xcodeproj/
.superpowers/

# Firebase config (per-app, contains API keys)
StressMonitor/StressMonitor/GoogleService-Info.plist
.worktrees/

# Credentials — never commit. asc writes config.json here with --local/--bypass-keychain.
.asc/
*.p8
*.mobileprovision
*.p12
